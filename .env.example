# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Google Gemini AI (для AI-помощника чата)
# Получить ключ: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# Session Configuration
SESSION_COOKIE_NAME="sushi_session"
SESSION_MAX_AGE=604800

# Admin Authentication
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_this_password"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_chat_id_here"

# Finik Payment Gateway Configuration
# Get credentials from https://averspay.kg
FINIK_ENV=beta
FINIK_API_KEY="your_finik_api_key_here"
FINIK_ACCOUNT_ID="your_finik_account_id_here"
# For production, also add:
# FINIK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
